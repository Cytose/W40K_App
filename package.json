{
  "name": "w40k-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aide de jeu Necrons pour Warhammer 40 000, 11e edition : editeur de listes, simulateur de sequence d'attaque et aide de jeu en partie.",
  "scripts": {
    "build": "node build.js",
    "catalogue": "node outils/catalogue.js",
    "dispositions": "node outils/dispositions.js",
    "gabarits": "node outils/test-gabarits.mjs",
    "dispositions-test": "node outils/test-dispositions.mjs",
    "orientation": "node outils/test-orientation.mjs",
    "cartes": "python3 outils/cartes-officielles.py",
    "decors": "python3 outils/empreintes.py",
    "densite": "python3 outils/empreintes.py --densite",
    "formes": "python3 outils/formes.py",
    "poses": "python3 outils/poses.py",
    "fond": "node outils/test-fond.mjs"
  },
  "devDependencies": {
    "terser": "^5.36.0"
  }
